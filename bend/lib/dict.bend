# The config's lang code. A code the dictionary lacks reads every word in
# English, as useDict does.
def lang(+code: String) -> Lang:
  Bool.pick(Lang, String.eq(code, "en"), LEn{},
  Bool.pick(Lang, String.eq(code, "de"), LDe{},
  Bool.pick(Lang, String.eq(code, "nl"), LNl{},
  Bool.pick(Lang, String.eq(code, "da"), LDa{},
  Bool.pick(Lang, String.eq(code, "ro"), LRo{},
  Bool.pick(Lang, String.eq(code, "fr"), LFr{},
  Bool.pick(Lang, String.eq(code, "gr"), LGr{},
  Bool.pick(Lang, String.eq(code, "it"), LIt{},
  Bool.pick(Lang, String.eq(code, "es"), LEs{},
  Bool.pick(Lang, String.eq(code, "nb"), LNb{},
  Bool.pick(Lang, String.eq(code, "bg"), LBg{},
  Bool.pick(Lang, String.eq(code, "cs"), LCs{},
  Bool.pick(Lang, String.eq(code, "si"), LSi{},
  Bool.pick(Lang, String.eq(code, "fi"), LFi{},
  Bool.pick(Lang, String.eq(code, "sv"), LSv{},
  Bool.pick(Lang, String.eq(code, "pt"), LPt{},
  Bool.pick(Lang, String.eq(code, "ca"), LCa{},
  Bool.pick(Lang, String.eq(code, "hr"), LHr{},
  LOther{}))))))))))))))))))

# useDict(word): the word in the language, or in English when it has none.
def get(+w: Phrase, +l: Lang) -> String:
  match w:
    case WApparentTitle{}:
      match l:
        case LDe{}:
          "Gefühlt"
        case LNl{}:
          "Schijnbare"
        case LDa{}:
