def size(+w: Widgets, +id: String) -> List<&2, C.Cmd>:
  match w:
    case Widgets{+apparent, +temp1, +temp2, +temp3, +barometer, +windchill, +humidity, +moonsun, +solar, +status, +raintitle, +rain1, +rain2, +rain3, +uv, +winddir, +windspeed, +graphs, +forecast, +records}:
      cat(size.apparent(String.eq(id, "Apparent01"), apparent), cat(size.temp1(String.eq(id, "TempBar01"), temp1), cat(size.temp2(String.eq(id, "TempBar02"), temp2), cat(size.temp3(String.eq(id, "TempBar03"), temp3), cat(size.barometer(String.eq(id, "Barometer01"), barometer), cat(size.windchill(String.eq(id, "Windchill01"), windchill), cat(size.humidity(String.eq(id, "HumidityGauge01"), humidity), cat(size.moonsun(String.eq(id, "MoonSun01"), moonsun), cat(size.solar(String.eq(id, "SolarBar01"), solar), cat(size.status(String.eq(id, "Status01"), status), cat(size.raintitle(String.eq(id, "TitleRainfall01"), raintitle), cat(size.rain1(String.eq(id, "RainBar1"), rain1), cat(size.rain2(String.eq(id, "RainBar2"), rain2), cat(size.rain3(String.eq(id, "RainBar3"), rain3), cat(size.uv(String.eq(id, "UVBar01"), uv), cat(size.winddir(String.eq(id, "WindGauge01"), winddir), cat(size.windspeed(String.eq(id, "WindSpeed01"), windspeed), [])))))))))))))))))

# frameUpdate: every enabled stage draws.
def frame(+w: Widgets, +e: E.Env, +now: U32) -> List<&2, C.Cmd>:
  match w:
    case Widgets{+apparent, +temp1, +temp2, +temp3, +barometer, +windchill, +humidity, +moonsun, +solar, +status, +raintitle, +rain1, +rain2, +rain3, +uv, +winddir, +windspeed, +graphs, +forecast, +records}:
      cat(draw.apparent(E.on(e, "apparent.enabled"), apparent, e, now), cat(draw.temp1(E.on(e, "temperature.enabled"), temp1, e, now), cat(draw.temp2(E.on(e, "temperature02.enabled"), temp2, e, now), cat(draw.temp3(E.on(e, "temperature03.enabled"), temp3, e, now), cat(draw.barometer(E.on(e, "barometer.enabled"), barometer, e, now), cat(draw.windchill(E.on(e, "windChill.enabled"), windchill, e, now), cat(draw.humidity(E.on(e, "humidity.enabled"), humidity, e, now), cat(draw.moonsun(E.on(e, "moonSun.enabled"), moonsun, e, now), cat(draw.solar(E.on(e, "solar.enabled"), solar, e, now), cat(draw.status(E.on(e, "status.enabled"), status, e, now), cat(draw.raintitle(E.on(e, "rainfallTitle.enabled"), raintitle, e, now), cat(draw.rain1(E.on(e, "rainfallDay.enabled"), rain1, e, now), cat(draw.rain2(E.on(e, "rainfallMonth.enabled"), rain2, e, now), cat(draw.rain3(E.on(e, "rainfallYear.enabled"), rain3, e, now), cat(draw.uv(E.on(e, "UV.enabled"), uv, e, now), cat(draw.winddir(E.on(e, "windDirection.enabled"), winddir, e, now), cat(draw.windspeed(E.on(e, "windSpeed.enabled"), windspeed, e, now), [])))))))))))))))))

# clientRawDataUpdate (cr) and clientRawExtraDataUpdate (cre): the enabled
# widgets listening redraw. A widget on both events redraws once per event,
# which comes to the same as once.
def data(+w: Widgets, +e: E.Env, +cr: Bool, +cre: Bool, +now: U32) -> Widgets:
  match w:
    case Widgets{+apparent, +temp1, +temp2, +temp3, +barometer, +windchill, +humidity, +moonsun, +solar, +status, +raintitle, +rain1, +rain2, +rain3, +uv, +winddir, +windspeed, +graphs, +forecast, +records}:
      Widgets{data.apparent(E.on(e, "apparent.enabled") && cr, apparent, e, False{}, now), data.temp1(E.on(e, "temperature.enabled") && cr, temp1, e, False{}, now), data.temp2(E.on(e, "temperature02.enabled") && (cr || cre), temp2, e, False{}, now), data.temp3(E.on(e, "temperature03.enabled") && (cr || cre), temp3, e, False{}, now), data.barometer(E.on(e, "barometer.enabled") && cr, barometer, e, False{}, now), data.windchill(E.on(e, "windChill.enabled") && cr, windchill, e, False{}, now), data.humidity(E.on(e, "humidity.enabled") && cr, humidity, e, False{}, now), data.moonsun(E.on(e, "moonSun.enabled") && cre, moonsun, e, False{}, now), data.solar(E.on(e, "solar.enabled") && (cr || cre), solar, e, False{}, now), status, raintitle, data.rain1(E.on(e, "rainfallDay.enabled") && cr, rain1, e, False{}, now), data.rain2(E.on(e, "rainfallMonth.enabled") && cr, rain2, e, False{}, now), data.rain3(E.on(e, "rainfallYear.enabled") && cr, rain3, e, False{}, now), data.uv(E.on(e, "UV.enabled") && cr, uv, e, False{}, now), data.winddir(E.on(e, "windDirection.enabled") && cr, winddir, e, False{}, now), data.windspeed(E.on(e, "windSpeed.enabled") && cr, windspeed, e, False{}, now), graphs, forecast, records}

# The tooltips that follow their widget's state, after a data event.
def retip(+w: Widgets, +e: E.Env) -> List<&2, C.Cmd>:
  match w:
    case Widgets{+apparent, +temp1, +temp2, +temp3, +barometer, +windchill, +humidity, +moonsun, +solar, +status, +raintitle, +rain1, +rain2, +rain3, +uv, +winddir, +windspeed, +graphs, +forecast, +records}:
      +tips = E.on(e, "general.tooltipsEnabled")
      cat(Bool.pick(List<&2, C.Cmd>, tips && E.on(e, "windChill.enabled"), [C.CTip{"Windchill01", TempBar.tip(windchill, e)}], []), [])

# drawStatusS01, on every completed tryUpdateWidgets pass.
def status(+w: Widgets, +e: E.Env, +failed: List<&2, Bool>, +no_change: Bool, +now: U32) -> Widgets:
  match w:
    case Widgets{+apparent, +temp1, +temp2, +temp3, +barometer, +windchill, +humidity, +moonsun, +solar, +status, +raintitle, +rain1, +rain2, +rain3, +uv, +winddir, +windspeed, +graphs, +forecast, +records}:
      Widgets{apparent, temp1, temp2, temp3, barometer, windchill, humidity, moonsun, solar, Status.data(status, e, failed, no_change, now), raintitle, rain1, rain2, rain3, uv, winddir, windspeed, graphs, forecast, records}

# updateUnits(kind): the widgets showing that kind redraw, unitChange true.
def units(+w: Widgets, +e: E.Env, +k: String, +now: U32) -> Widgets:
  match w:
    case Widgets{+apparent, +temp1, +temp2, +temp3, +barometer, +windchill, +humidity, +moonsun, +solar, +status, +raintitle, +rain1, +rain2, +rain3, +uv, +winddir, +windspeed, +graphs, +forecast, +records}:
      Widgets{data.apparent(E.on(e, "apparent.enabled") && String.eq(k, "Temp"), apparent, e, True{}, now), data.temp1(E.on(e, "temperature.enabled") && String.eq(k, "Temp"), temp1, e, True{}, now), data.temp2(E.on(e, "temperature02.enabled") && String.eq(k, "Temp"), temp2, e, True{}, now), data.temp3(E.on(e, "temperature03.enabled") && String.eq(k, "Temp"), temp3, e, True{}, now), data.barometer(E.on(e, "barometer.enabled") && String.eq(k, "Pressure"), barometer, e, True{}, now), data.windchill(E.on(e, "windChill.enabled") && String.eq(k, "Temp"), windchill, e, True{}, now), humidity, moonsun, solar, status, raintitle, data.rain1(E.on(e, "rainfallDay.enabled") && String.eq(k, "Rainfall"), rain1, e, True{}, now), data.rain2(E.on(e, "rainfallMonth.enabled") && String.eq(k, "Rainfall"), rain2, e, True{}, now), data.rain3(E.on(e, "rainfallYear.enabled") && String.eq(k, "Rainfall"), rain3, e, True{}, now), uv, winddir, data.windspeed(E.on(e, "windSpeed.enabled") && String.eq(k, "Wind"), windspeed, e, True{}, now), graphs, forecast, records}

